# Copy to .env next to compose.yaml. Never commit .env.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public name: the web app at https://SITE_DOMAIN/, the sync API at https://SITE_DOMAIN/api
SITE_DOMAIN=volleyballtactics.example.com
# Baked into the web build as the default server URL in Team → Data (override only if the API lives elsewhere)
# PUBLIC_API_URL=https://volleyballtactics.example.com/api

# Server already runs a reverse proxy? Join its network (see compose.shared-proxy.yaml).
# Separator is ":" on Linux/macOS, ";" on Windows.
# COMPOSE_FILE=compose.yaml:compose.shared-proxy.yaml
# PROXY_NETWORK=shared-proxy

# ── Postgres (operational system of record) ──────────────────────────────────
POSTGRES_USER=vt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vt

# ── API ──────────────────────────────────────────────────────────────────────
# Shared secret the web app sends as a bearer token (Team → Data → Shared database).
# Generate one:  openssl rand -hex 32
SYNC_TOKEN=change-me
# Browser origins allowed to call the API from another origin (the site itself is same-origin).
CORS_ORIGINS=https://volleyballtactics.example.com,https://rodelberonilla.github.io,http://localhost:5173
# Host ports, bound to 127.0.0.1 only; the proxy reaches the containers over Docker networking.
API_PORT=8080
WEB_PORT=8088
MAX_PAYLOAD_MB=25

# ── Pipeline ─────────────────────────────────────────────────────────────────
# local  = Parquet + DuckDB inside the `lake` volume (no cloud needed)
# gcp    = Parquet in Cloud Storage + BigQuery (needs the three settings below and ./secrets/gcp-sa.json)
PIPELINE_TARGET=local
PIPELINE_INTERVAL_SECONDS=900
GCP_PROJECT=
GCS_BUCKET=
BQ_LOCATION=northamerica-northeast2
FRESHNESS_HOURS=48
# Optional: POST failed checks here (Slack incoming webhook, n8n webhook, Discord, ...)
ALERT_WEBHOOK_URL=

# ── Optional profiles ────────────────────────────────────────────────────────
# docker compose --profile bi
METABASE_PORT=3001
