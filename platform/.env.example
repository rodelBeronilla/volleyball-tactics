# Copy to .env next to compose.yaml. Never commit .env.

# ── Postgres (operational system of record) ──────────────────────────────────
POSTGRES_USER=vt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vt

# ── API ──────────────────────────────────────────────────────────────────────
# Shared secret the web app sends as a bearer token (Team → Data → Shared database).
# Generate one:  openssl rand -hex 32
SYNC_TOKEN=change-me
# Browser origins allowed to call the API: the Cloud Run URL, GitHub Pages, local dev.
CORS_ORIGINS=http://localhost:5173,https://rodelberonilla.github.io
API_PORT=8080
MAX_PAYLOAD_MB=25

# ── Pipeline ─────────────────────────────────────────────────────────────────
# local  = Parquet + DuckDB inside the `lake` volume (no cloud needed)
# gcp    = Parquet in Cloud Storage + BigQuery (needs the three settings below and ./secrets/gcp-sa.json)
PIPELINE_TARGET=local
PIPELINE_INTERVAL_SECONDS=900
GCP_PROJECT=
GCS_BUCKET=
BQ_LOCATION=northamerica-northeast2
FRESHNESS_HOURS=48
# Optional: POST failed checks here (Slack incoming webhook, n8n webhook, Discord, ...)
ALERT_WEBHOOK_URL=

# ── Optional profiles ────────────────────────────────────────────────────────
# docker compose --profile edge: Caddy terminates TLS for this hostname (DNS must point at the server)
API_DOMAIN=
# docker compose --profile bi
METABASE_PORT=3000
